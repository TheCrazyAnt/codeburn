{
  "name": "codeburn-leaderboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CodeBurn opt-in public leaderboard backend (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply codeburn-leaderboard --local",
    "migrate:remote": "wrangler d1 migrations apply codeburn-leaderboard --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.128.0"
  }
}
